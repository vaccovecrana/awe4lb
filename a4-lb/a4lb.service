[Unit]
Description=awe4lb - a layer 4 load balancer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=awe4lb
Group=awe4lb
WorkingDirectory=/etc/a4lb
# Resolve exec-based health checks and discovery commands deterministically.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The API/UI has no authentication. Keep it on localhost or a trusted VPN.
ExecStart=/usr/local/bin/a4lb --api-host=127.0.0.1 --api-port=7070 --config=/etc/a4lb/active.json
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65535
# CAP_NET_RAW is intentionally not granted. Exec health checks that use raw
# ICMP (ping) need unprivileged ICMP enabled for the a4lb group instead.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/a4lb
UMask=0027

[Install]
WantedBy=multi-user.target
