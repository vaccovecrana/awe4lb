{
  "scripts": {
    "build:fonts": "node tools/gen-fonts.mjs",
    "build:scss": "sass res/main.scss build/ui/index.css --load-path=node_modules",
    "build": "npm run build:fonts && tsc --noEmit && rspack build --mode production && npm run build:scss",
    "dev": "rspack serve --mode development",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "visual": "node test/visual.mjs"
  },
  "author": "Vaccove Crana, LLC.",
  "dependencies": {
    "@fontsource/clear-sans": "5.3.0",
    "chart.js": "4.5.1",
    "preact": "10.29.8",
    "preact-router": "4.1.2",
    "react-chartjs-2": "5.3.1",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.3",
    "@rspack/core": "2.2.3",
    "puppeteer": "25.12.0",
    "sass": "1.104.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
